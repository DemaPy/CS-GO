# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local-only assets — never commit (plan Step 3.1)
.local/

# Rejected dev-placeholder asset — decompiled Valve, must not enter git history
c4-explosive/

.DS_Store

# Local-only dev model built from the REJECTED placeholder asset (plan Step 9.1).
# Never commit: its geometry is decompiled Valve work and Step 11.4 greps for it.
/public/models/
