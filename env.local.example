# Template for .env.local — copy it into place:
#
#     cp env.local.example .env.local
#
# This file is dotless on purpose. Claude Code enforces a built-in write deny on
# .env* paths that the project allow-list cannot override, so the template lives
# here and you copy it across. See docs/env-vars.md for the full rationale.

# ─── Checkout: Paddle ────────────────────────────────────────────────────────
# Revision 3 (2026-09-07): checkout moved from Stripe Payment Link to Paddle.
# Paddle has no Stripe-style shareable payment link, so checkout goes through
# Paddle.js as an overlay, opened with the email captured on the 3D display.
# No card fields live in this app.
#
# From Paddle > Developer tools > Authentication.
# The client token is safe to expose — it is scoped to client-side checkout.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# "sandbox" during development, "production" for live.
# Tokens and price IDs are environment-scoped: a sandbox pri_... does not exist
# in production, and a sandbox token with env=production fails to load.
NEXT_PUBLIC_PADDLE_ENV=sandbox
# From Paddle > Catalog > Prices. Looks like pri_01h...
NEXT_PUBLIC_PADDLE_PRICE_ID=

# ─── Email capture: Resend ───────────────────────────────────────────────────
# Server-only. Read by /api/capture, never sent to the client. Do NOT prefix
# these with NEXT_PUBLIC_ — that would ship your API key to the browser.
#
# From https://resend.com/api-keys. Starts with re_.
# "Sending access" is enough for transactional mail; adding a contact to an
# audience needs "Full access".
CAPTURE_RESEND_API_KEY=
# From https://resend.com/audiences. A UUID.
# Optional — omit it and /api/capture validates and logs without storing.
CAPTURE_RESEND_AUDIENCE_ID=
